# BFF base URL.
#
# Leave empty to use the Vite dev proxy (vite.config.ts forwards /api to
# http://localhost:9009). Same origin, so no CORS configuration is needed.
#
# Set an absolute URL to call the BFF directly — then add this app's dev origin
# to the BFF's CORS_ORIGINS, e.g. CORS_ORIGINS=http://localhost:3034
VITE_BFF_URL=

# Standalone dev only: a handlaggningId from the OUL, used when no host portal
# passes one in.
VITE_DEV_HANDLAGGNING_ID=

# Standalone dev only: the bearer token sent with POST /api/task/done, which the
# BFF refuses with 401 without one. Inside the portal the token comes from the
# portal's own login instead. The portal's dev tokens look like "<typId>:<varde>".
VITE_DEV_BEARER_TOKEN=
